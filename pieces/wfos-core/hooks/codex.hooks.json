{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/tessera\" gate --platform=codex --event=PreToolUse",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\tessera.exe\" gate --platform=codex --event=PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/tessera\" gate --platform=codex --event=PermissionRequest",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\tessera.exe\" gate --platform=codex --event=PermissionRequest",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
