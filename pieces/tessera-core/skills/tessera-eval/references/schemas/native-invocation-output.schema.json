{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "selected_skills", "reason"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["direct", "skill"]
    },
    "selected_skills": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reason": {"type": "string"}
  }
}
