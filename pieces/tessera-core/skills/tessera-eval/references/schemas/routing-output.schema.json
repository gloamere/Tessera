{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "reason"],
  "properties": {
    "route": {
      "type": "string",
      "enum": [
        "direct",
        "tessera-eval",
        "taste",
        "frontend-design",
        "knowledge-base",
        "finance-ops",
        "growth-ops",
        "product-planning",
        "business-ops"
      ]
    },
    "reason": {"type": "string"}
  }
}
